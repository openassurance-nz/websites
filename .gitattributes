# Line endings are LF everywhere: in the repository and in every working tree,
# on every platform.
* text=auto eol=lf

*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.php  text eol=lf
*.sql  text eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.gif binary
*.svg text eol=lf
*.ico binary
*.woff binary
*.woff2 binary
